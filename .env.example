# See docs/SELF_HOSTING.md for all configuration.
POSTGRES_PASSWORD=
SESSION_SECRET=
PUBLIC_URL=http://localhost:3000
# Optional: token for completing first-run setup from another machine (otherwise one is printed in the log).
MONITORING_SETUP_TOKEN=
# Set to 1 when Monitoring runs behind one reverse proxy (nginx, Caddy, a load balancer).
MONITORING_TRUST_PROXY=
PORT=3000
MONITORING_RETENTION_DAYS=15
# Telemetry storage: postgres (default, one database) or clickhouse (faster on large data, ~14x less disk).
# With Compose, ClickHouse also needs `--profile clickhouse` and a CLICKHOUSE_PASSWORD.
MONITORING_STORAGE=postgres
CLICKHOUSE_PASSWORD=
# From-source with ClickHouse:
# MONITORING_CLICKHOUSE_URL=http://localhost:8123
# From-source only (URL-encode credentials if needed):
DATABASE_URL=postgresql://monitoring:CHANGE_ME@localhost:5432/monitoring
# Optional compose agent profile; obtain a key from Organization Settings:
MONITORING_AGENT_API_KEY=
