diff -ruN a/agent-ci/config_platform_test.go b/agent-ci/config_platform_test.go
--- a/agent-ci/config_platform_test.go	1970-01-01 10:00:00.000000000 +1000
+++ b/agent-ci/config_platform_test.go	2026-11-23 19:54:59.999857198 +1100
@@ -0,0 +1,111 @@
+package main
+
+import (
+	"testing"
+
+	"go.yaml.in/yaml/v3"
+)
+
+func fakeEnv(m map[string]string) func(string) string { return func(k string) string { return m[k] } }
+
+func TestPlatformDefaults(t *testing.T) {
+	if got := defaultStateDir("linux", fakeEnv(nil)); got != "/var/lib/monitoring-agent" {
+		t.Fatal(got)
+	}
+	if got := defaultStateDir("darwin", fakeEnv(nil)); got != "/var/lib/monitoring-agent" {
+		t.Fatal(got)
+	}
+	if got := defaultConfigPathFor("linux", fakeEnv(nil)); got != "/etc/monitoring/monitoring.yaml" {
+		t.Fatal(got)
+	}
+	if got := defaultConfigPathFor("darwin", fakeEnv(nil)); got != "/etc/monitoring/monitoring.yaml" {
+		t.Fatal("macOS default must be unchanged:", got)
+	}
+	env := fakeEnv(map[string]string{"ProgramData": `D:\Data\`})
+	if got := defaultStateDir("windows", env); got != `D:\Data\Monitoring\state` {
+		t.Fatal(got)
+	}
+	if got := defaultConfigPathFor("windows", env); got != `D:\Data\Monitoring\monitoring.yaml` {
+		t.Fatal(got)
+	}
+	if got := defaultStateDir("windows", fakeEnv(nil)); got != `C:\ProgramData\Monitoring\state` {
+		t.Fatal(got)
+	}
+}
+
+func scraperKeys(t *testing.T, goos string) map[string]bool {
+	old := hostOS
+	hostOS = goos
+	defer func() { hostOS = old }()
+	c := defaults()
+	c.APIKey = "unit-test-key"
+	out, err := generateConfig(c)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var doc map[string]any
+	if err := yaml.Unmarshal(out, &doc); err != nil {
+		t.Fatal(err)
+	}
+	sc := doc["receivers"].(map[string]any)["hostmetrics"].(map[string]any)["scrapers"].(map[string]any)
+	keys := map[string]bool{}
+	for k := range sc {
+		keys[k] = true
+	}
+	return keys
+}
+
+func TestHostScrapersUnixSetUnchanged(t *testing.T) {
+	for _, goos := range []string{"linux", "darwin"} {
+		got := scraperKeys(t, goos)
+		want := []string{"load", "filesystem", "disk", "network", "paging", "processes", "cpu", "memory"}
+		if len(got) != len(want) {
+			t.Fatalf("%s: %v", goos, got)
+		}
+		for _, k := range want {
+			if !got[k] {
+				t.Fatalf("%s missing %s", goos, k)
+			}
+		}
+	}
+}
+
+func TestHostScrapersWindowsOmitsProcessesOnly(t *testing.T) {
+	got := scraperKeys(t, "windows")
+	if got["processes"] {
+		t.Fatal("processes scraper must not be configured on Windows")
+	}
+	for _, k := range []string{"load", "filesystem", "disk", "network", "paging", "cpu", "memory"} {
+		if !got[k] {
+			t.Fatalf("windows missing %s", k)
+		}
+	}
+	if len(got) != 7 {
+		t.Fatal(got)
+	}
+}
+
+func TestWindowsStateDirAndLogPathsSurviveGenerate(t *testing.T) {
+	old := hostOS
+	hostOS = "windows"
+	defer func() { hostOS = old }()
+	c := defaults()
+	c.APIKey = "unit-test-key"
+	c.Logs = []logConfig{{Path: `C:\logs\app.log`, Service: "app"}}
+	out, err := generateConfig(c)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var doc map[string]any
+	if err := yaml.Unmarshal(out, &doc); err != nil {
+		t.Fatal(err)
+	}
+	fs := doc["extensions"].(map[string]any)["file_storage"].(map[string]any)
+	if fs["directory"] != c.StateDir || c.StateDir == "/var/lib/monitoring-agent" {
+		t.Fatal("state dir not the Windows default:", fs["directory"])
+	}
+	inc := doc["receivers"].(map[string]any)["filelog/service_0"].(map[string]any)["include"].([]any)
+	if inc[0] != `C:\logs\app.log` {
+		t.Fatal(inc)
+	}
+}
