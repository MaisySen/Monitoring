+// hostOS is the target OS. Tests override it to exercise another platform's behaviour.
+var hostOS = runtime.GOOS
+
+// defaultStateDir keeps the Linux and macOS default unchanged; Windows uses %ProgramData%.
+func defaultStateDir(goos string, getenv func(string) string) string {
+	if goos == "windows" {
+		return programData(getenv) + `\Monitoring\state`
+	}
+	return "/var/lib/monitoring-agent"
+}
+
+// defaultConfigPathFor keeps /etc/monitoring/monitoring.yaml everywhere except Windows.
+func defaultConfigPathFor(goos string, getenv func(string) string) string {
+	if goos == "windows" {
+		return programData(getenv) + `\Monitoring\monitoring.yaml`
+	}
+	return "/etc/monitoring/monitoring.yaml"
+}
+
+func programData(getenv func(string) string) string {
+	if base := strings.TrimRight(getenv("ProgramData"), `\/`); base != "" {
+		return base
+	}
+	return `C:\ProgramData`
+}
+
+// hostScrapers returns the hostmetrics scraper set. The `processes` scraper is not supported on Windows by the
+// pinned hostmetrics receiver (its README lists Linux, Mac, FreeBSD, OpenBSD), so it is left out there only.
+func hostScrapers(goos string, connections bool) object {
+	scrapers := object{}
+	for _, s := range []string{"load", "filesystem", "disk", "paging"} {
+		scrapers[s] = object{}
+	}
+	if goos != "windows" {
+		scrapers["processes"] = object{}
+	}
+	// Connection-state counts walk every process's sockets in /proc on each scrape (the agent's
+	// biggest idle CPU cost); they are opt-in (host_metrics.connections).
+	scrapers["network"] = object{"metrics": object{"system.network.connections": object{"enabled": connections}}}
+	scrapers["cpu"] = object{"metrics": object{"system.cpu.utilization": object{"enabled": true}}}
+	scrapers["memory"] = object{"metrics": object{"system.memory.utilization": object{"enabled": true}}}
+	return scrapers
+}
